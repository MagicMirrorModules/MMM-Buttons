{
  "name": "mmm-buttons",
  "version": "2.1.3",
  "description": "A module for connecting multiple buttons.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MagicMirrorModules/MMM-Buttons.git"
  },
  "type": "commonjs",
  "keywords": [
    "MagicMirror",
    "module",
    "buttons",
    "GPIO",
    "notifications"
  ],
  "author": "Joseph Bethge",
  "contributors": [
    {
      "name": "Contributors",
      "url": "https://github.com/MagicMirrorModules/MMM-Buttons/graphs/contributors?all=1"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/MagicMirrorModules/MMM-Buttons/issues"
  },
  "homepage": "https://github.com/MagicMirrorModules/MMM-Buttons#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "commit-and-tag-version": "^13.3.0",
    "cspell": "^10.4.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "lint-staged": "^17.6.0",
    "simple-git-hooks": "^2.14.0"
  },
  "scripts": {
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "node --run lint && node --run test:unit",
    "test:spelling": "cspell .",
    "test:unit": "node --test tests/unit/*.test.js",
    "prepare": "simple-git-hooks || true",
    "release": "commit-and-tag-version --config ./changelog.config.mjs",
    "release:minor": "commit-and-tag-version --release-as minor --config ./changelog.config.mjs",
    "release:major": "commit-and-tag-version --release-as major --config ./changelog.config.mjs"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": [
      "eslint --fix"
    ]
  },
  "allowScripts": {
    "simple-git-hooks@2.14.0": true
  }
}
